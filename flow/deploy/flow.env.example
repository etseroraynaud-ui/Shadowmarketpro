# Collecteur Market Flow : copié en flow.env (chmod 600) par « smp-bot flow configure ».
# Jeton partagé avec le site (variable FLOW_INGEST_TOKEN sur Vercel) : il autorise l'écriture des données.
FLOW_INGEST_TOKEN=
FLOW_INGEST_URL=https://www.shadowmarketpro.com/api/market-flow/ingest
# Poids Hyperliquid par minute (limite officielle 1 200 par IP, partagée avec le bot sur ce serveur).
FLOW_HL_BUDGET=600
FLOW_COINS=BTC,ETH
