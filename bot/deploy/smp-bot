#!/usr/bin/env bash
# Commandes du bot Shock Engine sur le serveur (installé par install.sh comme « smp-bot »).
#
#   smp-bot configure              configure le bot réel (questions : réseau, adresses, clé de l'agent)
#   smp-bot status                 état des services
#   smp-bot logs [shadow|live]     journal en direct (Ctrl+C pour quitter)
#   smp-bot trades [shadow|live]   trades fermés (CSV)
#   smp-bot pause                  bot réel : plus aucune nouvelle entrée (la position en cours reste gérée)
#   smp-bot resume                 bot réel : entrées de nouveau permises
#   smp-bot live-start             démarre le bot réel (bot/deploy/live.env)
#   smp-bot live-stop              arrête le bot réel
#   smp-bot live-reset             après un HALT, compte remis à plat : repart de zéro
#   smp-bot version [public|v1]    version de la stratégie (sans argument : celle en cours) ;
#                                  public : shorts seulement en régime de tendance journalier baissier
#   smp-bot update                 récupère la dernière version et redémarre
#
#   Market Flow (collecteur CVD + whales de la page /market-flow, indépendant du bot) :
#   smp-bot flow configure         crée le jeton d'envoi vers le site (à copier dans Vercel)
#   smp-bot flow token             réaffiche le jeton
#   smp-bot flow check             vérifie que le site accepte le jeton et que Supabase est prêt
#   smp-bot flow start|stop        démarre / arrête le collecteur
#   smp-bot flow logs|status       journal en direct / état
#   smp-bot flow import FICHIER    reprend une base whale_BTC.db ou whale_ETH.db du dashboard local
set -euo pipefail

DIR=${SMP_DIR:-/opt/shadowmarketpro}
ENV_FILE=$DIR/bot/deploy/live.env
SHADOW_FILE=$DIR/bot/deploy/shadow.env
# Le service live n'existe que si live.env existe (il contient le mode et la clé).
compose() {
  if [ -f "$ENV_FILE" ]; then docker compose -f "$DIR/bot/deploy/compose.yml" --profile live "$@"
  else docker compose -f "$DIR/bot/deploy/compose.yml" "$@"; fi
}
service() { case "${1:-shadow}" in shadow|live) echo "${1:-shadow}" ;; *) echo "service inconnu : $1 (shadow ou live)" >&2; exit 1 ;; esac; }
running() { [ -n "$(compose ps -q --status running "$1" 2>/dev/null)" ]; }

check_env() {
  [ -f "$ENV_FILE" ] || { echo "Bot réel pas encore configuré : smp-bot configure" >&2; exit 1; }
  local perm; perm=$(stat -c %a "$ENV_FILE")
  [ "$perm" = 600 ] || { echo "$ENV_FILE contient la clé de l'agent : chmod 600 $ENV_FILE (actuellement $perm)." >&2; exit 1; }
  grep -Eq '^BOT_MODE=(testnet|mainnet)$' "$ENV_FILE" || { echo "BOT_MODE doit valoir testnet ou mainnet dans $ENV_FILE." >&2; exit 1; }
}

# Questions posées sur le terminal, même quand le script arrive par « curl … | bash ».
TTY=${SMP_TTY:-/dev/tty}
ask() { local v; printf '%s' "$1" >&2; IFS= read -r v < "$TTY" || true; printf '%s' "$v"; }
ask_secret() { local v; printf '%s' "$1" >&2; IFS= read -rs v < "$TTY" || true; echo >&2; printf '%s' "$v"; }
is_address() { [[ "$1" =~ ^0x[0-9a-fA-F]{40}$ ]]; }
# Ce qu'un copier-coller ajoute souvent : espaces, retours à la ligne, marqueurs de collage du terminal.
clean() { local v=${1//$'\e[200~'/}; v=${v//$'\e[201~'/}; printf '%s' "$v" | tr -d '[:space:]'; }

# Variable KEY=VAL dans un fichier d'environnement : remplacée si elle existe, ajoutée sinon (droits conservés).
set_var() {
  local file=$1 key=$2 val=$3
  [ -f "$file" ] || { ( umask 077; : > "$file" ); }
  if grep -q "^$key=" "$file"; then sed -i "s/^$key=.*/$key=$val/" "$file"; else echo "$key=$val" >> "$file"; fi
}
# Market Flow : projet docker séparé (flow/deploy/compose.yml), secret dans flow.env (root seul).
FLOW_ENV=$DIR/flow/deploy/flow.env
flow_compose() { docker compose -f "$DIR/flow/deploy/compose.yml" "$@"; }
flow_running() { [ -n "$(flow_compose ps -q --status running flow 2>/dev/null)" ]; }
new_token() { openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

flow_token() { grep -E '^FLOW_INGEST_TOKEN=' "$FLOW_ENV" 2>/dev/null | cut -d= -f2-; }

# Envoi vide au site : il ne fait que vérifier le jeton, puis les tables et fonctions Supabase.
flow_check() {
  [ -f "$FLOW_ENV" ] || { echo "Collecteur pas encore configuré : smp-bot flow configure" >&2; return 1; }
  local url code body
  url=$(grep -E '^FLOW_INGEST_URL=' "$FLOW_ENV" | cut -d= -f2-)
  url=${url:-https://www.shadowmarketpro.com/api/market-flow/ingest}
  body=$(mktemp)
  code=$(curl -s -m 20 -o "$body" -w '%{http_code}' -X POST "$url" -H "Authorization: Bearer $(flow_token)" \
    -H 'Content-Type: application/json' -d '{"coin":"BTC","bars":[],"whales":[],"status":null}' || true)
  case "$code" in
    200) echo "OK : le site accepte le jeton et les tables Supabase sont en place." ;;
    401) echo "Jeton refusé : la valeur de FLOW_INGEST_TOKEN dans Vercel n'est pas celle du serveur (smp-bot flow token l'affiche). Corrige-la dans Vercel, puis Redeploy." ;;
    503) echo "Le site n'a pas encore le jeton : ajoute FLOW_INGEST_TOKEN dans Vercel (Production), puis Redeploy, et réessaie dans 2 minutes." ;;
    502) echo "Le jeton est bon, mais les tables manquent dans Supabase : SQL Editor, coller flow/supabase.sql, Run." ;;
    404) echo "Le site n'a pas encore l'API Market Flow (déploiement en cours ?) : réessaie dans quelques minutes." ;;
    000|"") echo "Site injoignable depuis le serveur ($url)." ;;
    *) echo "Réponse inattendue du site (HTTP $code) : $(head -c 200 "$body")" ;;
  esac
  rm -f "$body"
  [ "$code" = 200 ]
}

flow_cmd() {
  case "${1:-status}" in
    configure)
      if [ -f "$FLOW_ENV" ] && grep -Eq '^FLOW_INGEST_TOKEN=.+' "$FLOW_ENV"; then
        local again; again=$(ask "Un jeton existe déjà. En créer un nouveau (l'ancien ne marchera plus) ? [o/N] : ")
        case "$again" in o|O|oui|y|Y) ;; *) echo "Jeton inchangé."; return ;; esac
      fi
      [ -f "$FLOW_ENV" ] || { ( umask 077; cp "$DIR/flow/deploy/flow.env.example" "$FLOW_ENV" ); }
      chmod 600 "$FLOW_ENV"
      local token; token=$(new_token)
      set_var "$FLOW_ENV" FLOW_INGEST_TOKEN "$token"
      echo "Jeton enregistré dans $FLOW_ENV (lisible par root seul)."
      echo
      echo "À copier dans Vercel → projet → Settings → Environment Variables :"
      echo "  nom    : FLOW_INGEST_TOKEN"
      echo "  valeur : $token"
      echo "  environnement : Production, puis Deployments → Redeploy."
      echo
      echo "Ne le partage avec personne : il permet d'écrire les données de la page Market Flow."
      echo "Ensuite, une fois le jeton enregistré dans Vercel : smp-bot flow check, puis smp-bot flow start"
      ;;
    token)
      [ -n "$(flow_token)" ] || { echo "Pas encore de jeton : smp-bot flow configure" >&2; exit 1; }
      flow_token
      ;;
    check) flow_check ;;
    start)
      [ -f "$FLOW_ENV" ] || { echo "Collecteur pas encore configuré : smp-bot flow configure" >&2; exit 1; }
      flow_check || echo "(Le collecteur démarre quand même : il garde 24 h de données et les enverra dès que le site les accepte.)"
      flow_compose up -d --build flow
      echo "Collecteur démarré. Suivre : smp-bot flow logs (une ligne d'état toutes les 5 minutes)"
      ;;
    stop) flow_compose stop flow ;;
    logs) flow_compose logs -f --tail 100 flow ;;
    status) flow_compose ps ;;
    import)
      local src=${2:-} name
      [ -f "$src" ] || { echo "smp-bot flow import /chemin/whale_BTC.db" >&2; exit 1; }
      name=$(basename "$src")
      case "$name" in whale_BTC.db|whale_ETH.db) ;; *) echo "Nom attendu : whale_BTC.db ou whale_ETH.db" >&2; exit 1 ;; esac
      [ -f "$FLOW_ENV" ] || { echo "Collecteur pas encore configuré : smp-bot flow configure" >&2; exit 1; }
      # Copie dans un dossier temporaire (avec les fichiers -wal / -shm s'ils sont là), puis sauvegarde
      # SQLite cohérente vers le volume du collecteur, collecteur arrêté.
      local tmp; tmp=$(mktemp -d); chmod 777 "$tmp"
      cp "$src" "$tmp/"; for x in wal shm; do [ -f "$src-$x" ] && cp "$src-$x" "$tmp/"; done
      chmod 666 "$tmp"/*
      local was=0; flow_running && was=1
      flow_compose stop flow
      flow_compose run --rm --no-deps -v "$tmp:/import" --entrypoint python flow -c \
        "import sqlite3; s=sqlite3.connect('/import/$name'); d=sqlite3.connect('/data/$name'); s.backup(d); d.close(); print('importé :', s.execute('select count(*) from hl_accounts').fetchone()[0], 'comptes')"
      rm -rf "$tmp"
      [ "$was" = 1 ] && flow_compose up -d flow
      echo "Base $name reprise par le collecteur."
      ;;
    *) echo "smp-bot flow configure|token|check|start|stop|logs|status|import FICHIER" >&2; exit 1 ;;
  esac
}

version_of() { if [ -f "$1" ] && grep -q '^BOT_SHORT_TREND_FILTER=1$' "$1"; then echo public; else echo v1; fi; }

# L'état du bot réel est mis de côté (pas effacé) : au démarrage, le bot vérifie que le compte est à
# plat, rejoue l'historique et reprend la main dès que le backtest est à plat.
live_reset() {
  compose stop live
  compose run --rm --no-deps --entrypoint sh live -c 'for f in /data/state/live-*.json; do [ -e "$f" ] && mv "$f" "$f.$(date +%s).bak"; done; true'
  compose up -d live
}

configure() {
  echo "Configuration du bot réel. Les réponses vont seulement dans $ENV_FILE, lisible par root seul."
  echo
  local net account sub key notional extra="" confirm start
  net=$(ask "Réseau — testnet ou mainnet [testnet] : "); net=${net:-testnet}
  case "$net" in
    testnet) notional=1000 ;;
    mainnet)
      echo "MAINNET : le bot trade de l'argent réel, avec le capital du compte tradé." >&2
      confirm=$(ask "Tape MAINNET pour confirmer : ")
      [ "$confirm" = MAINNET ] || { echo "Annulé." >&2; exit 1; }
      notional=$(ask "Valeur maximale d'une position, en dollars [100] : "); notional=${notional:-100}
      [[ "$notional" =~ ^[0-9]+$ ]] && [ "$notional" -ge 10 ] || { echo "Montant invalide (10 $ au moins)." >&2; exit 1; }
      extra="BOT_ALLOW_MAINNET=1"
      ;;
    *) echo "Réseau inconnu : $net (testnet ou mainnet)." >&2; exit 1 ;;
  esac
  account=$(clean "$(ask "1/3 Adresse de ton compte Hyperliquid (0x…) : ")")
  is_address "$account" || { echo "Adresse invalide : 0x suivi de 40 caractères hexadécimaux." >&2; exit 1; }
  sub=$(clean "$(ask "2/3 Adresse du sous-compte du bot (Entrée s'il n'y en a pas) : ")")
  [ -z "$sub" ] || is_address "$sub" || { echo "Adresse de sous-compte invalide." >&2; exit 1; }
  key=$(clean "$(ask_secret "3/3 Clé privée du wallet agent « $net » (ne s'affiche pas) : ")")
  [[ "$key" =~ ^0x ]] || key="0x$key"
  if ! [[ "$key" =~ ^0x[0-9a-fA-F]{64}$ ]]; then
    # Seule la longueur est indiquée : la clé n'est jamais affichée.
    local n=$(( ${#key} - 2 ))
    if [ "$n" -eq 0 ]; then echo "Aucune clé reçue : rien n'a été collé." >&2
    elif [ "$n" -eq 40 ]; then echo "C'est une adresse (40 caractères), pas une clé privée. Il faut la clé privée de l'agent : 64 caractères." >&2
    elif [ "$n" -eq 128 ]; then echo "La clé a été collée deux fois : la coller une seule fois, puis Entrée." >&2
    elif [ "$n" -eq 64 ]; then echo "La clé contient des caractères qui ne sont pas hexadécimaux (0-9, a-f)." >&2
    else echo "Clé invalide : 64 caractères hexadécimaux attendus, $n reçus." >&2
    fi
    echo "La clé privée de l'agent n'est montrée qu'à sa création (page API de Hyperliquid $net). Si tu ne l'as plus, crée et autorise un nouveau wallet API, puis recommence : smp-bot configure" >&2
    exit 1
  fi

  # L'ancien fichier est gardé de côté jusqu'à ce que la nouvelle configuration soit vérifiée.
  local backup=""
  if [ -f "$ENV_FILE" ]; then backup="$ENV_FILE.bak.$(date +%Y%m%d-%H%M%S)"; cp -p "$ENV_FILE" "$backup"; fi
  ( umask 077
    { echo "# Écrit par « smp-bot configure » le $(date -u +%Y-%m-%dT%H:%MZ). Contient la clé de l'agent."
      echo "BOT_MODE=$net"
      [ -n "$extra" ] && echo "$extra"
      echo "BOT_COIN=BTC"
      echo "HL_ACCOUNT_ADDRESS=$account"
      echo "HL_SUBACCOUNT_ADDRESS=$sub"
      printf 'HL_AGENT_PRIVATE_KEY=%s\n' "$key"
      echo "BOT_EQUITY_PCT=100"
      echo "BOT_LEVERAGE=1"
      echo "BOT_MAX_NOTIONAL_USD=$notional"
      echo "# Version publique du Shock Engine : shorts seulement en régime de tendance journalier baissier."
      echo "BOT_SHORT_TREND_FILTER=1"
    } > "$ENV_FILE.new" )
  key=""
  local was_running=0
  running live && was_running=1
  mv "$ENV_FILE.new" "$ENV_FILE"
  chmod 600 "$ENV_FILE"

  echo
  echo "Vérification auprès de Hyperliquid ($net), sans aucun ordre :"
  if ! compose run --rm --no-deps -T live node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/tools/access-check.ts < /dev/null; then
    if [ -n "$backup" ]; then mv "$backup" "$ENV_FILE"; else rm -f "$ENV_FILE"; fi
    echo "Configuration refusée : rien n'a été changé." >&2
    exit 1
  fi
  [ -z "$backup" ] || echo "Ancienne configuration gardée dans $backup."
  echo
  start=$(ask "Démarrer le bot réel ($net) maintenant ? [O/n] : ")
  case "${start:-o}" in
    o|O|oui|y|Y) compose up -d --force-recreate live; echo "Bot réel démarré. Suivre : smp-bot logs live" ;;
    *)
      if [ "$was_running" = 1 ]; then compose stop live; echo "Bot réel arrêté (nouvelle configuration prise en compte au prochain smp-bot live-start)."
      else echo "Pour le démarrer plus tard : smp-bot live-start"; fi
      ;;
  esac
}

case "${1:-help}" in
  configure) configure ;;
  status) compose ps ;;
  logs) compose logs -f --tail 100 "$(service "${2:-}")" ;;
  trades) compose exec "$(service "${2:-}")" sh -c 'cat /data/logs/trades-*.csv 2>/dev/null || echo "Aucun trade fermé pour l’instant."' ;;
  pause) check_env; compose exec live sh -c 'mkdir -p /data/state && touch /data/state/KILL' && echo "Nouvelles entrées bloquées." ;;
  resume) check_env; compose exec live rm -f /data/state/KILL && echo "Entrées de nouveau permises." ;;
  live-start)
    check_env
    echo "Démarrage du bot réel : $(grep -E '^BOT_MODE=' "$ENV_FILE" | cut -d= -f2), $(grep -E '^BOT_COIN=' "$ENV_FILE" | cut -d= -f2 || echo BTC)."
    compose up -d --build live
    echo "Suivre : smp-bot logs live"
    ;;
  live-stop)
    compose stop live
    echo "Bot réel arrêté. Une position ouverte reste chez Hyperliquid avec son stop, mais le stop suiveur ne bouge plus."
    ;;
  live-reset)
    check_env
    live_reset
    echo "Bot réel relancé sans état. Suivre : smp-bot logs live"
    ;;
  version)
    if [ -z "${2:-}" ]; then
      echo "shadow : $(version_of "$SHADOW_FILE")"
      [ -f "$ENV_FILE" ] && echo "bot réel : $(version_of "$ENV_FILE")"
      exit 0
    fi
    case "$2" in public) val=1 ;; v1) val=0 ;; *) echo "smp-bot version public|v1" >&2; exit 1 ;; esac
    set_var "$SHADOW_FILE" BOT_SHORT_TREND_FILTER "$val"
    compose up -d --force-recreate shadow
    echo "Shadow mode : version $2 (historique rejoué avec cette version)."
    if [ -f "$ENV_FILE" ]; then
      check_env
      set_var "$ENV_FILE" BOT_SHORT_TREND_FILTER "$val"
      if running live; then
        # L'état sauvegardé a été construit avec l'autre version : repartir de zéro, compte à plat.
        echo "Bot réel : le compte doit être à plat (sinon le bot s'arrête sans rien faire, HALT)." >&2
        confirm=$(ask "Relancer le bot réel sans état avec la version $2 ? [o/N] : ")
        case "$confirm" in
          o|O|oui|y|Y) live_reset; echo "Bot réel relancé sans état, version $2. Suivre : smp-bot logs live" ;;
          *) echo "Bot réel inchangé jusqu'au prochain smp-bot live-reset (la nouvelle version est enregistrée dans live.env)." ;;
        esac
      else
        echo "Bot réel : version $2 enregistrée ; elle s'applique au prochain smp-bot live-start."
      fi
    fi
    ;;
  update)
    git -C "$DIR" pull --ff-only
    services=shadow
    if running live; then check_env; services="shadow live"; fi
    # shellcheck disable=SC2086
    compose up -d --build $services
    if flow_running; then flow_compose up -d --build flow; fi
    ;;
  flow) shift; flow_cmd "$@" ;;
  *) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
