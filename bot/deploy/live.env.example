# Bot réel. Le plus simple : « smp-bot configure » écrit ce fichier pour toi (questions, vérification).
# À la main : copier en bot/deploy/live.env, remplir, puis chmod 600. Contient la clé de l'agent : jamais commité ni envoyé.

# testnet d'abord ; mainnet seulement après plusieurs semaines sans écart.
BOT_MODE=testnet
BOT_COIN=BTC

# Compte principal (adresse publique) qui a approuvé le wallet agent.
HL_ACCOUNT_ADDRESS=0x
# Sous-compte dédié au bot (adresse publique). Vide : le bot trade le compte principal.
HL_SUBACCOUNT_ADDRESS=
# Clé privée du wallet agent (page API de Hyperliquid). Il peut trader, pas retirer.
HL_AGENT_PRIVATE_KEY=0x

# Taille : part du capital du compte tradé, levier, plafond de la valeur d'une position.
BOT_EQUITY_PCT=100
BOT_LEVERAGE=1
BOT_MAX_NOTIONAL_USD=1000
