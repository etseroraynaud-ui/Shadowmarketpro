# Shadow mode (facultatif). Copier en bot/deploy/shadow.env pour changer l'actif ou le capital simulé.
# BOT_MODE est imposé à shadow par compose.yml : ce service ne trade jamais.
BOT_COIN=BTC
# 1 : version publique (shorts seulement en tendance journalière baissière). 0 : moteur v1.
BOT_SHORT_TREND_FILTER=0
BOT_SHADOW_CAPITAL=10000
