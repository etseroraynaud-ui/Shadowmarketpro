{
  "name": "shock-engine-bot",
  "private": true,
  "type": "module",
  "description": "Bot Hyperliquid du Shock Engine : shadow mode, testnet, mainnet. Même moteur que Backtest Lab (lib/strategies/shock).",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts",
    "check": "../node_modules/.bin/tsc -p tsconfig.json",
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/main.ts",
    "parity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/tools/parity-cli.ts"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "^0.33.3",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
